# North Star / Logia local runtime configuration.
# Copy this file to .env and fill real values locally. Do not commit .env.

# DeepSeek model gateway adapter. Keep the real key outside Git.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=<set-locally-or-in-secret-manager>
DEEPSEEK_MODEL=deepseek-chat

# Slack protected action path. Keep real Slack values outside Git.
SLACK_WEBHOOK_URL=<optional-local-slack-webhook-url>
SLACK_SIGNING_SECRET=<optional-local-slack-signing-secret>

# Meta WhatsApp Cloud API. Use secure MuleSoft/Salesforce properties for
# shared environments; local .env is only for a developer machine.
META_WHATSAPP_ACCESS_TOKEN=<optional-local-meta-token>
META_WHATSAPP_PHONE_NUMBER_ID=<optional-local-phone-number-id>

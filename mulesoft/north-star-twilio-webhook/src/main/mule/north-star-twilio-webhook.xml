<?xml version="1.0" encoding="UTF-8" ?>
<mule
  xmlns="http://www.mulesoft.org/schema/mule/core"
  xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
  xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
  xmlns:http="http://www.mulesoft.org/schema/mule/http"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd"
>
    <configuration-properties file="mule-artifact.properties" />

    <http:listener-config name="northStarListener">
        <http:listener-connection host="0.0.0.0" port="${http.port}" />
    </http:listener-config>

    <http:request-config name="salesforceRequest">
        <http:request-connection
      protocol="HTTPS"
      host="${salesforce.host}"
      port="443"
    />
    </http:request-config>

    <flow name="meta-whatsapp-webhook-verify-root">
        <http:listener
      config-ref="northStarListener"
      path="/"
      allowedMethods="GET"
    >
            <http:response statusCode="#[vars.statusCode default 403]">
                <http:headers
        ><![CDATA[#[{'Content-Type': 'text/plain'}]]]></http:headers>
            </http:response>
        </http:listener>
        <flow-ref name="verify-meta-webhook" />
    </flow>

    <flow name="meta-whatsapp-webhook-verify-path">
        <http:listener
      config-ref="northStarListener"
      path="/meta/whatsapp/inbound"
      allowedMethods="GET"
    >
            <http:response statusCode="#[vars.statusCode default 403]">
                <http:headers
        ><![CDATA[#[{'Content-Type': 'text/plain'}]]]></http:headers>
            </http:response>
        </http:listener>
        <flow-ref name="verify-meta-webhook" />
    </flow>

    <flow name="whatsapp-inbound-root">
        <http:listener
      config-ref="northStarListener"
      path="/"
      allowedMethods="POST"
    >
            <http:response statusCode="200">
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="200">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:error-response>
        </http:listener>
        <set-variable
      variableName="responseFormat"
      value="#[if (((attributes.headers.'content-type' default '') as String) contains 'json') 'json' else 'twiml']"
    />
        <flow-ref name="process-whatsapp-inbound" />
    </flow>

    <flow name="twilio-whatsapp-inbound">
        <http:listener
      config-ref="northStarListener"
      path="/twilio/whatsapp/inbound"
      allowedMethods="POST"
    >
            <http:response statusCode="200">
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="200">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:error-response>
        </http:listener>
        <set-variable variableName="responseFormat" value="twiml" />
        <flow-ref name="process-whatsapp-inbound" />
    </flow>

    <flow name="meta-whatsapp-inbound">
        <http:listener
      config-ref="northStarListener"
      path="/meta/whatsapp/inbound"
      allowedMethods="POST"
    >
            <http:response statusCode="200">
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:response>
            <http:error-response statusCode="200">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers
        ><![CDATA[#[{
                    'Content-Type': if (vars.responseFormat == 'twiml') 'text/xml' else 'application/json'
                }]]]></http:headers>
            </http:error-response>
        </http:listener>
        <set-variable variableName="responseFormat" value="json" />
        <flow-ref name="process-whatsapp-inbound" />
    </flow>

    <flow name="verify-meta-webhook">
        <choice doc:name="Verify Meta webhook token">
            <when
        expression="#[attributes.queryParams.'hub.mode' == 'subscribe' and attributes.queryParams.'hub.verify_token' == p('meta.webhookVerifyToken')]"
      >
                <set-variable variableName="statusCode" value="200" />
                <set-payload
          value="#[attributes.queryParams.'hub.challenge']"
        />
            </when>
            <otherwise>
                <set-variable variableName="statusCode" value="403" />
                <set-payload value="Forbidden" />
            </otherwise>
        </choice>
    </flow>

    <flow name="process-whatsapp-inbound">
        <ee:transform doc:name="Map WhatsApp webhook to safe North Star intake">
            <ee:message>
                <ee:set-payload
        ><![CDATA[%dw 2.0
output application/json
var isMeta = vars.responseFormat == "json"
var bodyText = if (isMeta) write(payload, "application/json") else ((payload.Body default payload.body default "") as String)
var lowerBody = lower(bodyText)
var twilioMediaCount = ((payload.NumMedia default "0") as Number) default 0
var mediaCount = if (isMeta and ((lowerBody contains "audio") or (lowerBody contains "image") or (lowerBody contains "document") or (lowerBody contains "video"))) 1 else if (isMeta) 0 else twilioMediaCount
var firstMediaType =
    if (isMeta and (lowerBody contains "audio")) "audio/unknown"
    else if (isMeta and (lowerBody contains "image")) "image/unknown"
    else if (isMeta and (lowerBody contains "document")) "application/octet-stream"
    else if (isMeta and (lowerBody contains "video")) "video/unknown"
    else ((payload.MediaContentType0 default "") as String)
var firstMediaKind =
    if (firstMediaType startsWith "audio/") "voice note"
    else if (firstMediaType startsWith "image/") "image"
    else if (firstMediaType == "application/octet-stream") "document"
    else if (firstMediaType startsWith "video/") "video"
    else if (mediaCount > 0) "media file"
    else "none"
var firstMediaReference = if (isMeta) "" else ((payload.MediaUrl0 default "") as String)
---
{
    tenantKey: p("northstar.tenant"),
    purpose: p("northstar.purpose"),
    messageSid: if (isMeta) uuid() else ((payload.MessageSid default payload.SmsSid default uuid()) as String),
    sourceChannel: if (isMeta) "Meta WhatsApp Cloud API" else "Twilio Sandbox WhatsApp",
    responseFormat: vars.responseFormat,
    rawBody: bodyText,
    from: if (isMeta) "" else ((payload.From default "") as String),
    messageSummary:
        if (isMeta) "A WhatsApp Cloud API message was received."
        else if (bodyText != "") "A WhatsApp message was received."
        else if (mediaCount > 0) "A WhatsApp " ++ firstMediaKind ++ " was received and needs transcript or extraction before action."
        else "A WhatsApp message needs service review.",
    mediaCount: mediaCount,
    firstMediaType: firstMediaType,
    firstMediaKind: firstMediaKind,
    mediaUrl0: firstMediaReference,
    clinicalRequest: false
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <http:request
      method="POST"
      config-ref="salesforceRequest"
      path="/services/apexrest/northstar/v1/twilio/whatsapp"
    >
            <http:headers
      ><![CDATA[#[{
                'Authorization': 'Bearer ' ++ p('salesforce.accessToken'),
                'Content-Type': 'application/json'
            }]]]></http:headers>
        </http:request>

        <choice doc:name="Return channel acknowledgement">
            <when expression="#[vars.responseFormat == 'twiml']">
                <ee:transform doc:name="Return Twilio acknowledgement">
                    <ee:message>
                        <ee:set-payload
            ><![CDATA[%dw 2.0
output application/xml
---
{
    Response: {
        Message: "Thanks. North Star received this. A manager will review it."
    }
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>
            <otherwise>
                <ee:transform doc:name="Return Meta acknowledgement">
                    <ee:message>
                        <ee:set-payload
            ><![CDATA[%dw 2.0
output application/json
---
{
    status: "received"
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </otherwise>
        </choice>

        <error-handler>
            <on-error-continue enableNotifications="true" logException="true">
                <choice doc:name="Return safe fallback acknowledgement">
                    <when expression="#[vars.responseFormat == 'twiml']">
                        <ee:transform doc:name="Return safe Twilio fallback">
                            <ee:message>
                                <ee:set-payload
                ><![CDATA[%dw 2.0
output application/xml
---
{
    Response: {
        Message: "Thanks. North Star received this. A manager will review it."
    }
}]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>
                    </when>
                    <otherwise>
                        <ee:transform doc:name="Return safe Meta fallback">
                            <ee:message>
                                <ee:set-payload
                ><![CDATA[%dw 2.0
output application/json
---
{
    status: "received"
}]]></ee:set-payload>
                            </ee:message>
                        </ee:transform>
                    </otherwise>
                </choice>
            </on-error-continue>
        </error-handler>
    </flow>
</mule>

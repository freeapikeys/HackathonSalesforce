  "components": {
    "securitySchemes": {
      "oauth2ClientCredentials": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://identity.example.com/oauth2/token",
            "scopes": {
              "hfs.integration": "Invoke governed HFS integration operations."
            }
          }
        }
      },
      "mutualTLS": {
        "type": "mutualTLS"
      }
    },
    "parameters": {
      "TenantId": {
        "name": "X-Tenant-Id",
        "in": "header",
        "required": true,
        "description": "Tenant isolation key; must match the body.",
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "description": "End-to-end trace identifier; must match the body.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Stable retry key scoped to tenant and operation; must match the body when the body contains one.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "CallbackUrl": {
        "name": "X-Callback-Url",
        "in": "header",
        "required": false,
        "description": "HTTPS endpoint for an optional signed completion callback.",
        "schema": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "callbacks": {
      "OperationCompleted": {
        "{$request.header.X-Callback-Url}": {
          "post": {
            "operationId": "receiveOperationCompletion",
            "summary": "Receive the requested completion callback",
            "parameters": [
              {
                "$ref": "#/components/parameters/TenantId"
              },
              {
                "$ref": "#/components/parameters/CorrelationId"
              }
            ],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/OperationCallback"
                  },
                  "examples": {
                    "ingestEvent": {
                      "$ref": "./examples/operation-examples-v1.json#/operations/ingestEvent/callback"
                    },
                    "retrieveContext": {
                      "$ref": "./examples/operation-examples-v1.json#/operations/retrieveContext/callback"
                    },
                    "executeApprovedAction": {
                      "$ref": "./examples/operation-examples-v1.json#/operations/executeApprovedAction/callback"
                    },
                    "receiveOutcomeCallback": {
                      "$ref": "./examples/operation-examples-v1.json#/operations/receiveOutcomeCallback/callback"
                    }
                  }
                }
              }
            },
            "responses": {
              "204": {
                "description": "The callback was durably accepted."
              }
            },
            "security": [
              {
                "oauth2ClientCredentials": [
                  "hfs.integration"
                ],
                "mutualTLS": []
              }
            ]
          }
        }
      }
    },
    "schemas": {
      "EventEnvelope": {
        "$ref": "../../integration/events/schemas/event-envelope-v1.schema.json"
      },
      "ServiceError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNSUPPORTED_CONTRACT_VERSION",
              "PERMISSION_DENIED",
              "CUSTOM_PERMISSION_REQUIRED",
              "RECORD_NOT_FOUND",
              "SOURCE_EVIDENCE_INACCESSIBLE",
              "TENANT_MISMATCH",
              "INVALID_STATE",
              "IDEMPOTENCY_CONFLICT",
              "VALIDATION_FAILED",
              "RETRYABLE_DEPENDENCY_FAILURE",
              "PARTIAL_FAILURE",
              "UNEXPECTED_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "fieldName": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "tenantKey",
          "correlationId",
          "operation",
          "success",
          "errors"
        ],
        "properties": {
          "contractVersion": {
            "const": "1.0.0"
          },
          "tenantKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "success": {
            "const": false
          },
          "errors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ServiceError"
            }
          }
        }
      },
      "EventIntakeResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "tenantKey",
          "correlationId",
          "eventId",
          "intakeResult",
          "replayed",
          "observedAt"
        ],
        "properties": {
          "contractVersion": {
            "const": "1.0.0"
          },
          "tenantKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "minLength": 1,
            "format": "uuid"
          },
          "intakeResult": {
            "type": "string",
            "enum": [
              "ACCEPTED",
              "DUPLICATE",
              "ACCEPTED_LATE",
              "ACCEPTED_OUT_OF_ORDER",
              "CONFLICT_REVIEW"
            ]
          },
          "replayed": {
            "type": "boolean"
          },
          "observedAt": {
            "type": "string",
            "minLength": 1,
            "format": "date-time"
          }
        }
      },
      "ContextRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractVersion",
          "tenantKey",
          "correlationId",
          "purpose",
          "includeProvenance",
          "timelineLimit"
        ],
        "properties": {
          "contractVersion": {
            "const": "1.0.0"
          },
          "tenantKey": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "correlationId": {

              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "denial": {
                    "$ref": "./examples/operation-examples-v1.json#/operations/ingestEvent/denial"
                  }
                }
              }
            }
          },
          "409": {
            "description": "The request conflicts with prior content or current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "conflict": {
                    "$ref": "./examples/operation-examples-v1.json#/operations/ingestEvent/conflict"
                  }
                }
              }
            }
          },
          "422": {
            "description": "The request is well formed but fails deterministic validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "validation": {
                    "$ref": "./examples/operation-examples-v1.json#/operations/ingestEvent/validation"

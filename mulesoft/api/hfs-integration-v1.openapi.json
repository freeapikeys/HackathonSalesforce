          },
          "503": {
            "description": "A required dependency is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "retryableFailure": {
                    "$ref": "./examples/operation-examples-v1.json#/operations/ingestEvent/retryableFailure"
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before the caller should retry.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "callbacks": {
          "operationCompleted": {
            "$ref": "#/components/callbacks/OperationCompleted"
          }
        },
        "security": [
          {
            "oauth2ClientCredentials": [
              "hfs.integration"
            ],
            "mutualTLS": []
          }
        ],
        "x-hfs-example-coverage": {
          "request": "./examples/operation-examples-v1.json#/operations/ingestEvent/request",
          "success": "./examples/operation-examples-v1.json#/operations/ingestEvent/success",
          "denial": "./examples/operation-examples-v1.json#/operations/ingestEvent/denial",
          "conflict": "./examples/operation-examples-v1.json#/operations/ingestEvent/conflict",
          "validation": "./examples/operation-examples-v1.json#/operations/ingestEvent/validation",
          "retryableFailure": "./examples/operation-examples-v1.json#/operations/ingestEvent/retryableFailure",
          "callback": "./examples/operation-examples-v1.json#/operations/ingestEvent/callback"
        }
      }
    },

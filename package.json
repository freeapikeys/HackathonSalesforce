{
  "name": "hackathon-salesforce",
  "private": true,
  "version": "1.0.0",
  "description": "North Star universal operations command center",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "npm run check:project && npm run check:ontology && npm run check:events && npm run check:mulesoft && npm run check:models && npm run check:agentforce && npm run check:metadata && npm run check:harness && npm run prettier:verify && npm run lint && npm run test:unit",
    "check:agentforce": "node scripts/run-python-task.mjs agentforce",
    "check:events": "node scripts/run-python-task.mjs events",
    "check:metadata": "node scripts/run-python-task.mjs metadata",
    "check:models": "node scripts/run-python-task.mjs models",
    "check:mulesoft": "node scripts/run-python-task.mjs mulesoft",
    "check:ontology": "node scripts/run-python-task.mjs ontology",
    "check:project": "node scripts/validate-salesforce-project.mjs",
    "check:harness": "node scripts/run-python-task.mjs harness-tests",
    "demo:check": "node scripts/run-python-task.mjs harness check",
    "demo:reset": "node scripts/run-python-task.mjs harness reset",
    "demo:seed": "node scripts/run-python-task.mjs harness seed",
    "demo:verify": "node scripts/run-python-task.mjs harness verify",
    "demo:run": "node scripts/run-python-task.mjs harness run",
    "verify:clean-clone": "./scripts/verify-clean-clone.sh",
    "lint": "eslint \"force-app/main/default/{aura,lwc}/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check sfdx-project.json package.json config/project-scratch-def.json config/core-salesforce-model.json manifest/package.xml .github/workflows/validate.yml eslint.config.js jest.config.js scripts/run-python-task.mjs && prettier --check --parser json ontology/context.jsonld ontology/examples/valid.jsonld ontology/examples/invalid.jsonld",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}

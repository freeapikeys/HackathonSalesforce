{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeapikeys.github.io/HackathonSalesforce/agentforce/agentforce-actions-v1.schema.json",
  "title": "HFS Agentforce Action Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "actionCatalog",
    "scenarios"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "actionCatalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionDefinition"
      },
      "minItems": 3
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      },
      "minItems": 7
    }
  },
  "$defs": {
    "actionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "developerName",
        "action",
        "target",
        "description",
        "requireUserConfirmation",
        "inputContract",
        "outputContract"
      ],
      "properties": {
        "developerName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "action": {
          "enum": [
            "EXPLAIN_RELATIONSHIP_CASE",
            "DRAFT_RELATIONSHIP_RECOMMENDATION",
            "REQUEST_HUMAN_APPROVAL"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^apex://[A-Za-z][A-Za-z0-9_]{0,79}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requireUserConfirmation": {
          "type": "boolean"
        },
        "inputContract": {
          "const": "#/$defs/actionRequest"
        },
        "outputContract": {
          "const": "#/$defs/actionResponse"
        }
      }
    },
    "actionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "action",
        "tenantKey",
        "correlationId",
        "purpose",
        "workItemId"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "action": {
          "enum": [
            "EXPLAIN_RELATIONSHIP_CASE",
            "DRAFT_RELATIONSHIP_RECOMMENDATION",
            "REQUEST_HUMAN_APPROVAL",
            "EXECUTE_EXTERNAL_ACTION"
          ]
        },
        "tenantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "workItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "recommendationId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "approvalPolicyKey": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "desiredOutcome": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "modelProfile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceType",
        "sourceEventId",
        "sourceUri",
        "contentHash",
        "summary",
        "accessible"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidenceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sourceEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sourceUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "accessible": {
          "const": true
        }
      }
    },
    "contextCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "evidenceIds",
        "recordIds"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "recordIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        }
      }
    },
    "contextCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceIds",
        "evidenceTypes",
        "evidenceCategories",
        "recordIdsByPrimitive"
      ],
      "properties": {
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "evidenceTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidenceCategories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complaint",
            "resource",
            "capacity",
            "partner",
            "billing",
            "stock",
            "staffing",
            "approval",
            "outcome"
          ],
          "properties": {
            "complaint": {
              "$ref": "#/$defs/contextCategory"
            },
            "resource": {
              "$ref": "#/$defs/contextCategory"
            },
            "capacity": {
              "$ref": "#/$defs/contextCategory"
            },
            "partner": {
              "$ref": "#/$defs/contextCategory"
            },
            "billing": {
              "$ref": "#/$defs/contextCategory"
            },
            "stock": {
              "$ref": "#/$defs/contextCategory"
            },
            "staffing": {
              "$ref": "#/$defs/contextCategory"
            },
            "approval": {
              "$ref": "#/$defs/contextCategory"
            },
            "outcome": {
              "$ref": "#/$defs/contextCategory"
            }
          }
        },
        "recordIdsByPrimitive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customerAliases",
            "departments",
            "locations",
            "resources",
            "partners",
            "processes",
            "recommendations",
            "approvals",
            "actions",
            "outcomes",
            "metrics"
          ],
          "properties": {
            "customerAliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "departments": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "resources": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "partners": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "processes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "recommendations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "approvals": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "outcomes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "uniqueItems": true
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "statement",
        "evidenceIds"
      ],
      "properties": {
        "factId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumptionId",
        "statement",
        "evidenceIds"
      ],
      "properties": {
        "assumptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inferenceId",
        "statement",
        "basisFactIds",
        "confidence"
      ],
      "properties": {
        "inferenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "basisFactIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendationType",
        "proposedActionType",
        "rationale",
        "confidence",
        "evidenceIds",
        "modelProfile",
        "modelInvocationId",
        "requiresHumanApproval"
      ],
      "properties": {
        "recommendationType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "proposedActionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "modelProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "modelInvocationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "requiresHumanApproval": {
          "const": true
        },
        "inventoryWasteReasoning": {
          "oneOf": [
            {
              "$ref": "#/$defs/inventoryWasteReasoning"
            },
            {
              "type": "null"
            }
          ]
        },
        "hospitalOperationsReasoning": {
          "oneOf": [
            {
              "$ref": "#/$defs/hospitalOperationsReasoning"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricKey",
        "formula",
        "value",
        "unit",
        "evidenceIds"
      ],
      "properties": {
        "metricKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "recommendedHospitalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionId",
        "actionType",
        "statement",
        "evidenceIds",
        "requiresHumanApproval"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "actionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "requiresHumanApproval": {
          "const": true
        }
      }
    },
    "blockedHospitalAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionType",
        "reason",
        "evidenceIds"
      ],
      "properties": {
        "actionType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "clinicalBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "statement",
        "evidenceIds"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "partnerCaution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "statement",
        "evidenceIds"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "evidenceQualityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingType",
        "summary",
        "action",
        "evidenceIds"
      ],
      "properties": {
        "findingType": {
          "enum": [
            "MISSING",
            "CONTRADICTORY",
            "RESTRICTED",
            "DUPLICATE",
            "LATE",
            "OUT_OF_ORDER",
            "MALFORMED",
            "LOW_CONFIDENCE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "conflictResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflictId",
        "tension",
        "resolution",
        "winningPolicy",
        "evidenceIds"
      ],
      "properties": {
        "conflictId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "tension": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "resolution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "winningPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "recommendationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "changedByEvidenceId",
        "before",
        "after",
        "decision",
        "evidenceIds"
      ],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "changedByEvidenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "serviceRecoveryDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draftId",
        "audience",
        "message",
        "approvalRequired",
        "approvalId",
        "policyReason",
        "privacySafe",
        "evidenceIds"
      ],
      "properties": {
        "draftId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "approvalRequired": {
          "const": true
        },
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policyReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "privacySafe": {
          "const": true
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "approvalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionState",
        "approvalId",
        "actionId",
        "approverRole",
        "policyReason",
        "evidenceIds"
      ],
      "properties": {
        "decisionState": {
          "enum": [
            "APPROVE",
            "REJECT",
            "MODIFY",
            "DEFER",
            "EXECUTE_READY"
          ]
        },
        "approvalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "approverRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "policyReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true,
          "minItems": 0
        }
      }
    },
    "financialImpactSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detectedCaseTypes",
        "exposureFormula",
        "exposureValue",
        "currencyCode",
        "timeWindow",
        "confidence",
        "approvalRequired",
        "protectedActionTypes",
        "personalDataPolicy",
        "evidenceIds"
      ],
      "properties": {
        "detectedCaseTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "exposureFormula": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "exposureValue": {
          "type": "number"
        },
        "currencyCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10

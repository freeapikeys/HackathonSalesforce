{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freeapikeys.github.io/HackathonSalesforce/models/model-gateway-v1.schema.json",
  "title": "HFS Provider-Neutral Model Gateway v1",
  "$defs": {
    "modelProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "version",
        "profileKey",
        "taskType",
        "inputSchemaRef",
        "outputSchemaRef",
        "requiredCapabilities",
        "minimumContextTokens",
        "permittedDataClassifications",
        "qualityObjective",
        "maximumLatencyMs",
        "maximumCostUsd",
        "fallbackMode",
        "status"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "taskType": {
          "type": "string",
          "enum": [
            "CLASSIFICATION",
            "EXPLANATION",
            "RECOMMENDATION",
            "MESSAGE_DRAFTING",
            "EMBEDDING"
          ]
        },
        "inputSchemaRef": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "outputSchemaRef": {
          "type": "string",
          "minLength": 1,
          "format": "uri-reference"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CHAT",
              "STRUCTURED_OUTPUT",
              "TOOL_USE",
              "VISION",
              "EMBEDDINGS"
            ]
          },
          "minItems": 1
        },
        "minimumContextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "permittedDataClassifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "minItems": 1
        },
        "qualityObjective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metricKey",
            "minimumScore",
            "evaluationSuiteVersion"
          ],
          "properties": {
            "metricKey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "minimumScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "evaluationSuiteVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "maximumLatencyMs": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "fallbackMode": {
          "type": "string",
          "enum": [
            "NONE",
            "QUALIFIED_ONLY"
          ]
        },
        "status": {
          "const": "ACTIVE"
        }
      }
    },
    "modelDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "version",
        "deploymentKey",
        "adapterKey",
        "adapterInterfaceVersion",
        "providerIdentifier",
        "modelIdentifier",
        "configuredModelIdentifier",
        "hostingClass",
        "residencyRegions",
        "supportedLanguages",
        "permittedDataClassifications",
        "capabilities",
        "contextWindowTokens",
        "qualifiedProfiles",
        "qualityScores",
        "estimatedLatencyMs",
        "estimatedCostUsd",
        "operationalStatus",
        "activeFrom",
        "activeUntil"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "deploymentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "adapterKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "adapterInterfaceVersion": {
          "const": "hfs.generate.v1"
        },
        "providerIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "modelIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "configuredModelIdentifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostingClass": {
          "type": "string",
          "enum": [
            "SALESFORCE_MANAGED",
            "CLOUD",
            "PRIVATE_CLOUD",
            "ON_PREM_RELAY",
            "MOCK"
          ]
        },
        "residencyRegions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        },
        "supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          },
          "minItems": 1
        },
        "permittedDataClassifications": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          },
          "minItems": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CHAT",
              "STRUCTURED_OUTPUT",
              "TOOL_USE",
              "VISION",
              "EMBEDDINGS"
            ]
          },
          "minItems": 1
        },
        "contextWindowTokens": {
          "type": "integer",
          "minimum": 1
        },
        "qualifiedProfiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        },
        "qualityScores": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minProperties": 1
        },
        "estimatedLatencyMs": {
          "type": "integer",
          "minimum": 1
        },
        "estimatedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "operationalStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "DEGRADED",
            "UNAVAILABLE",
            "RETIRED"
          ]
        },
        "activeFrom": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "activeUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "routingPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "version",
        "policyKey",
        "tenantKey",
        "businessUnit",
        "profileKey",
        "permittedPurposes",
        "candidatePriority",
        "requiredChecks",
        "fallbackMode",
        "effectiveFrom",
        "effectiveUntil"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
        },
        "policyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "tenantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "businessUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "permittedPurposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "candidatePriority": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "minItems": 1
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "TENANT",
              "BUSINESS_UNIT",
              "PURPOSE",
              "PROFILE",
              "DATA_CLASSIFICATION",
              "RESIDENCY",
              "LANGUAGE",
              "CAPABILITY",
              "CONTEXT_WINDOW",
              "QUALITY",
              "LATENCY",
              "COST",
              "STATUS",
              "AVAILABILITY"
            ]
          }
        },
        "fallbackMode": {
          "const": "QUALIFIED_ONLY"
        },
        "effectiveFrom": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        },
        "effectiveUntil": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "routingRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "correlationId",
        "tenantKey",
        "businessUnit",
        "agentKey",
        "subagentKey",
        "userId",
        "purpose",
        "profileKey",
        "dataClassification",
        "residencyRegion",
        "language",
        "requiredCapabilities",
        "requiredContextTokens",
        "maximumLatencyMs",
        "maximumCostUsd",
        "unavailableDeploymentKeys"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "tenantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "businessUnit": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "subagentKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "dataClassification": {
          "type": "string",
          "enum": [
            "PUBLIC",
            "INTERNAL",
            "CONFIDENTIAL",
            "RESTRICTED"
          ]
        },
        "residencyRegion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CHAT",
              "STRUCTURED_OUTPUT",
              "TOOL_USE",
              "VISION",
              "EMBEDDINGS"
            ]
          },
          "minItems": 1
        },
        "requiredContextTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maximumLatencyMs": {
          "type": "integer",
          "minimum": 1
        },
        "maximumCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "unavailableDeploymentKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      }
    },
    "routingDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "correlationId",
        "policyKey",
        "policyVersion",
        "profileKey",
        "profileVersion",
        "decision",
        "selectedDeploymentKey",
        "selectedDeploymentVersion",
        "fallback",
        "fallbackFromDeploymentKey",
        "checks",
        "decidedAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "policyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "SELECTED",
            "NO_QUALIFIED_DEPLOYMENT"
          ]
        },
        "selectedDeploymentKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedDeploymentVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallback": {
          "type": "boolean"
        },
        "fallbackFromDeploymentKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deploymentKey",
              "check",
              "passed",
              "reasonCode"
            ],
            "properties": {
              "deploymentKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "reasonCode": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            }
          },
          "minItems": 1
        },
        "decidedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date-time"
        }
      }
    },
    "generateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "correlationId",
        "tenantKey",
        "userId",
        "purpose",
        "agentKey",
        "profileKey",
        "profileVersion",
        "promptVersion",
        "retrievalVersion",
        "messages",
        "context",
        "responseSchema",
        "invocationPolicy"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "tenantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "agentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "retrievalVersion": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "SYSTEM",
                  "USER",
                  "ASSISTANT",
                  "TOOL"
                ]
              },
              "content": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          },
          "minItems": 1
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataClassification",
            "evidenceIds",
            "sourceContentHashes"
          ],
          "properties": {
            "dataClassification": {
              "type": "string",
              "enum": [
                "PUBLIC",
                "INTERNAL",
                "CONFIDENTIAL",
                "RESTRICTED"
              ]
            },
            "evidenceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1
            },
            "sourceContentHashes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "minItems": 1
            }
          }
        },
        "responseSchema": {
          "type": "object"
        },
        "invocationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maximumOutputTokens",
            "temperature",
            "retainContent",
            "requireCitations"
          ],
          "properties": {
            "maximumOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "retainContent": {
              "type": "boolean"
            },
            "requireCitations": {
              "const": true
            }
          }
        }
      }
    },
    "recommendationOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "inferences",
        "recommendation",
        "confidence",
        "evidenceIds",
        "requiresHumanApproval"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "recommendation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        },
        "requiresHumanApproval": {
          "const": true
        }
      }
    },
    "generateResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "correlationId",
        "invocationId",
        "profileKey",
        "profileVersion",
        "deploymentKey",
        "deploymentVersion",
        "adapterInterfaceVersion",
        "output",
        "finishReason",
        "outputSchemaValid",
        "safetyStatus"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "invocationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "profileKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "profileVersion": {
          "type": "string",
          "minLength": 1
        },
        "deploymentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "deploymentVersion": {
          "type": "string",
          "minLength": 1
        },
        "adapterInterfaceVersion": {
          "const": "hfs.generate.v1"
        },
        "output": {
          "$ref": "#/$defs/recommendationOutput"
        },
        "finishReason": {
          "type": "string",
          "enum": [
            "STOP",
            "LENGTH",
            "CONTENT_FILTER",
            "ERROR"
          ]
        },
        "outputSchemaValid": {
          "type": "boolean"
        },
        "safetyStatus": {
          "type": "string",
          "enum": [
            "PASSED",
            "BLOCKED",
            "REVIEW"
          ]
        }
      }
    },
    "invocationAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "invocationId",
        "correlationId",
        "tenantKey",
        "userId",
        "purpose",
        "agentKey",
        "profileKey",
        "profileVersion",
        "policyKey",
        "policyVersion",
        "selectedDeploymentKey",
        "selectedDeploymentVersion",
        "promptVersion",
        "retrievalVersion",
        "inputHash",
        "outputHash",
        "evidenceIds",
        "attempts",
        "fallbackUsed",
        "inputTokens",
        "outputTokens",
        "latencyMs",
        "costUsd",
        "safetyStatus",
        "outputSchemaValid",
        "retentionMode",
        "status",
        "completedAt"
      ],
      "properties": {
        "contractVersion": {
          "const": "1.0.0"
        },
        "invocationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "format": "uuid"
        },
        "tenantKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,

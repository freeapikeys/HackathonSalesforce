        "localTerm": "immutable event envelope",
        "locators": ["$"]
      },
      "salesforce": {
        "targets": [
          { "object": "HFS_Event__c", "field": "Event_Id__c" },
          { "object": "HFS_Event__c", "field": "Tenant_Key__c" },
          { "object": "HFS_Event__c", "field": "Event_Type__c" },
          { "object": "HFS_Event__c", "field": "Source_URI__c" },
          { "object": "HFS_Event__c", "field": "Subject__c" },
          { "object": "HFS_Event__c", "field": "Source_Record_Id__c" },
          { "object": "HFS_Event__c", "field": "Schema_Version__c" },
          { "object": "HFS_Event__c", "field": "Correlation_Id__c" },
          { "object": "HFS_Event__c", "field": "Causation_Id__c" },
          { "object": "HFS_Event__c", "field": "Idempotency_Key__c" },
          { "object": "HFS_Event__c", "field": "Source_Sequence__c" },
          { "object": "HFS_Event__c", "field": "Occurred_At__c" },
          { "object": "HFS_Event__c", "field": "Observed_At__c" },
          { "object": "HFS_Event__c", "field": "Content_Hash__c" },
          { "object": "HFS_Event__c", "field": "Payload_JSON__c" },
          { "object": "HFS_Event__c", "field": "Intake_Result__c" }

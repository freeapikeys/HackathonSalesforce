{
  "version": "1.0.0",
  "owner": "semantic-core",
  "updatedAt": "2026-06-10",
  "contracts": {
    "eventEnvelopeSchema": "integration/events/schemas/event-envelope-v1.schema.json",
    "salesforceModel": "config/core-salesforce-model.json",
    "ontology": "ontology/hfs-core.ttl",
    "context": "ontology/context.jsonld"
  },
  "coveragePolicy": {
    "eventEnvelope": "Every schema-defined envelope, business-record, and assertion field must be mapped.",
    "eventAttributes": "Every fixture attribute key is preserved with its source-local term and mapped to the closest canonical payload or concept.",
    "eventTypes": "Every fixture event type must match exactly one semantic event-type pattern.",
    "salesforce": "Every generated HFS Salesforce field must appear in exactly one mapping target."
  },
  "eventEnvelopeMappings": [
    {
      "id": "event.envelope.cloudevents-core",
      "owner": "semantic-core",
      "source": {
        "localTerm": "CloudEvents transport fields",
        "locators": [
          "$.specversion",
          "$.id",
          "$.source",
          "$.type",
          "$.subject",
          "$.time",
          "$.datacontenttype",
          "$.dataschema"
        ]
      },
      "data360": {
        "object": "SourceEvent",
        "field": "cloudEventsEnvelope"
      },
      "ontology": {
        "class": "hfs:Event",
        "property": "hfs:identifier"
      },
      "transformation": {
        "rule": "Copy CloudEvents fields exactly into the immutable source-event record and retain the full envelope for replay.",
        "loss": "none",
        "ambiguity": "CloudEvents id is unique inside the preserved tenant/source scope, not a universal business object identifier."
      }
    },
    {
      "id": "event.envelope.hfs-governance-extensions",
      "owner": "semantic-core",
      "source": {
        "localTerm": "HFS intake governance extensions",
        "locators": [
          "$.hfstenantid",
          "$.hfsschemaversion",
          "$.hfscorrelationid",
          "$.hfscausationid",
          "$.hfsidempotencykey",
          "$.hfssourcerecordid",
          "$.hfssourcesequence",
          "$.hfsobservedat",
          "$.hfscontenthash"
        ]
      },
      "data360": {
        "object": "SourceEvent",
        "field": "governanceExtensions"
      },
      "ontology": {
        "class": "hfs:Event",
        "property": "prov:wasGeneratedBy"
      },
      "transformation": {
        "rule": "Copy HFS extension fields exactly and use them for tenant isolation, replay detection, ordering, hashing, and lineage.",
        "loss": "none",
        "ambiguity": "Source sequence is only comparable within a tenant/source boundary."
      }
    },
    {
      "id": "event.envelope.business-record",
      "owner": "semantic-core",
      "source": {
        "localTerm": "Normalized business record",
        "locators": [
          "$.data",
          "$.data.recordtype",
          "$.data.operation",
          "$.data.businesskey",
          "$.data.effectiveat",
          "$.data.attributes"
        ]
      },
      "data360": {
        "object": "SourceRecord",
        "field": "normalizedBusinessRecord"
      },
      "ontology": {
        "class": "hfs:ProvenancedRecord",
        "property": "hfs:sourceRecordId"
      },
      "transformation": {
        "rule": "Preserve the normalized source payload as JSON, then project selected fields into Salesforce records by record type.",
        "loss": "none for preservation; selected projections may be narrower than the full payload",
        "ambiguity": "Record type is a platform-normalized category; source-local terminology remains in attributes and terminology mappings."
      }
    },
    {
      "id": "event.envelope.assertions",
      "owner": "semantic-core",
      "source": {
        "localTerm": "Source assertions",
        "locators": [
          "$.data.assertions",
          "$.data.assertions[].conflictkey",
          "$.data.assertions[].predicate",
          "$.data.assertions[].value"
        ]
      },
      "data360": {
        "object": "AssertionHistory",
        "field": "sourceAssertions"
      },
      "ontology": {
        "class": "hfs:Assertion",
        "property": "hfs:assertionPredicate"
      },
      "transformation": {
        "rule": "Convert source assertions into versioned claims keyed by conflict key, predicate, value, valid time, and recorded time.",
        "loss": "none for scalar assertion values",
        "ambiguity": "Conflicting values are preserved as competing assertions until review creates an explicit supersession."
      }
    }
  ],
  "eventTypePatterns": [
    {
      "id": "event-type.person",
      "owner": "semantic-core",
      "source": {
        "localTerm": "person events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.person\\..+\\.v1$"
      },
      "data360": {
        "object": "Individual",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Person",
        "property": "rdf:type"
      },
      "transformation": {
        "rule": "Map person source events to the person entity projection.",
        "loss": "none",
        "ambiguity": "Contact channels remain source attributes until consent and identity rules are added."
      }
    },
    {
      "id": "event-type.organization",
      "owner": "semantic-core",
      "source": {
        "localTerm": "organization events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.organization\\..+\\.v1$"
      },
      "data360": {
        "object": "Account",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Organization",
        "property": "rdf:type"
      },
      "transformation": {
        "rule": "Map organization source events to the organization entity projection.",
        "loss": "none",
        "ambiguity": "A source organization may represent a legal entity, operating unit, supplier, or prospect depending on context."
      }
    },
    {
      "id": "event-type.employee",
      "owner": "semantic-core",
      "source": {
        "localTerm": "employee relationship events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.employee\\..+\\.v1$"
      },
      "data360": {
        "object": "Relationship",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Relationship",
        "property": "hfs:relationshipType"
      },
      "transformation": {
        "rule": "Map employee observations into person-to-organization relationship records.",
        "loss": "none",
        "ambiguity": "Role names are source-local labels until mapped to a controlled organization role scheme."
      }
    },
    {
      "id": "event-type.supplier",
      "owner": "semantic-core",
      "source": {
        "localTerm": "supplier events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.(supplier|retail\\.supplier)\\..+\\.v1$"
      },
      "data360": {
        "object": "SupplierRelationship",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Organization",
        "property": "hfs:relationshipType"
      },
      "transformation": {
        "rule": "Map supplier identity, response, lead-time, and reliability signals into organization and relationship context.",
        "loss": "none",
        "ambiguity": "Supplier response events can update relationship context without automatically changing reorder policy."
      }
    },
    {
      "id": "event-type.agreement",
      "owner": "semantic-core",
      "source": {
        "localTerm": "agreement events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.agreement\\..+\\.v1$"
      },
      "data360": {
        "object": "Agreement",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Agreement",
        "property": "rdf:type"
      },
      "transformation": {
        "rule": "Map agreement events to agreement records and assertion histories.",
        "loss": "none",
        "ambiguity": "A changed agreement status may be a source claim until reviewed against contradictory records."
      }
    },
    {
      "id": "event-type.sop",
      "owner": "semantic-core",
      "source": {
        "localTerm": "SOP and coordinated-work events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.(sop|retail\\.(shelf|store|approved)|nexavenu\\.revenue\\.(discovery|close|approved))\\..+\\.v1$"
      },
      "data360": {
        "object": "WorkExecution",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:SOPExecution",
        "property": "rdf:type"
      },
      "transformation": {
        "rule": "Map SOP, readiness, approval, and task execution events into work and SOP execution records.",
        "loss": "none",
        "ambiguity": "Execution status is separate from business outcome; outcomes arrive as their own evidence."
      }
    },
    {
      "id": "event-type.issue",
      "owner": "semantic-core",
      "source": {
        "localTerm": "generic issue events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.issue\\..+\\.v1$"
      },
      "data360": {
        "object": "CaseOrIssue",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:WorkItem",
        "property": "hfs:supportedBy"
      },
      "transformation": {
        "rule": "Map issue events into work items, evidence, and recommendations as appropriate.",
        "loss": "none",
        "ambiguity": "Issue severity and priority are related but not identical; priority is assigned by policy."
      }
    },
    {
      "id": "event-type.retail-issue",
      "owner": "semantic-core",
      "source": {
        "localTerm": "retail risk and outcome events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.retail\\.(stockout|warehouse|expiry|nearexpiry|complaint|price|damaged|queue|outcome)\\..+\\.v1$"
      },
      "data360": {
        "object": "OperationalInsight",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Evidence",
        "property": "hfs:supportedBy"
      },
      "transformation": {
        "rule": "Map retail signals into evidence, work, recommendation, action, and outcome context without hard-coding retail as the product boundary.",
        "loss": "none",
        "ambiguity": "Retail terms such as batch, shelf, and promotion remain vertical terms layered over the shared relationship spine."
      }
    },
    {
      "id": "event-type.nexavenu-revenue-issue",
      "owner": "semantic-core",
      "source": {
        "localTerm": "Nexavenu revenue intelligence events",
        "typePattern": "^io\\.github\\.freeapikeys\\.hfs\\.nexavenu\\.revenue\\.(lead|buyer|buying|retention|outcome)\\..+\\.v1$"
      },
      "data360": {
        "object": "RevenueRelationshipInsight",
        "field": "sourceEventType"
      },
      "ontology": {
        "class": "hfs:Evidence",
        "property": "hfs:supportedBy"
      },
      "transformation": {
        "rule": "Map revenue-pipeline and relationship-health signals into the same evidence and recommendation spine used by other verticals.",
        "loss": "none",
        "ambiguity": "Contact-sourced assumptions are evidence-labeled assumptions, not public facts."
      }
    }
  ],

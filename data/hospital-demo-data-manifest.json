{
  "name": "North Star private hospital demo data",
  "sourceOfTruth": "data/hospital",
  "safety": {
    "mode": "synthetic_demo_only",
    "realPatientData": false,
    "clinicalDecisionData": false,
    "credentialData": false
  },
  "validation": ["npm run check:demo-data", "npm run check:fixture-language"],
  "files": [
    {
      "path": "data/hospital/master_data.json",
      "contains": [
        "hospital departments",
        "locations",
        "synthetic customer aliases",
        "staff role aliases",
        "partner aliases"
      ]
    },
    {
      "path": "data/hospital/resources.json",
      "contains": [
        "hospital resources",
        "beds",
        "rooms",
        "queues",
        "staff pools",
        "supplies",
        "equipment"
      ]
    },
    {
      "path": "data/hospital/complaints.json",
      "contains": [
        "synthetic patient and visitor complaints",
        "complaint types",
        "linked departments",
        "linked resources",
        "evidence IDs"
      ]
    },
    {
      "path": "data/hospital/complaint_clusters.json",
      "contains": [
        "clustered complaints",
        "dominant issue types",
        "source complaint IDs",
        "evidence IDs"
      ]
    },
    {
      "path": "data/hospital/capacity_pressure.json",
      "contains": [
        "queue pressure",
        "capacity records",
        "staff coverage signals"
      ]
    },
    {
      "path": "data/hospital/supply_positions.json",
      "contains": [
        "pharmacy and supply positions",
        "stock cover",
        "usage",
        "lead-time risk"
      ]
    },
    {
      "path": "data/hospital/financial_cases.json",
      "contains": [
        "billing cases",
        "insurance cases",
        "refund requests",
        "payment failures",
        "revenue risk"
      ]
    },
    {
      "path": "data/hospital/partner_responses.json",
      "contains": [
        "partner responses",
        "vendor SLA signals",
        "recommendation-changing evidence"
      ]
    },
    {
      "path": "data/hospital/task_templates.json",
      "contains": [
        "approved task templates",
        "owner role aliases",
        "service windows",
        "escalation windows"
      ]
    },
    {
      "path": "data/hospital/channel_aliases.json",
      "contains": [
        "Slack role aliases",
        "WhatsApp-style role aliases",
        "privacy-safe internal targets"
      ]
    },
    {
      "path": "data/hospital/recommendation_cases.json",
      "contains": [
        "expected Agentforce recommendation cases",
        "approval requirements",
        "refusal boundaries"
      ]
    },
    {
      "path": "data/hospital/event_stream.json",
      "contains": [
        "hospital event summaries",
        "late events",
        "duplicate events",
        "malformed events",
        "clinical refusal event"
      ]
    },
    {
      "path": "data/hospital/supply_batches.json",
      "contains": ["hospital supply batches"]
    },
    {
      "path": "data/hospital/service_recovery_options.json",
      "contains": ["service response options"]
    }
  ]
}

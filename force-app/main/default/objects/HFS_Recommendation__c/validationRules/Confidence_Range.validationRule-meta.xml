<?xml version='1.0' encoding='utf-8'?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Confidence_Range</fullName>
    <active>true</active>
    <description>Confidence must be between 0 and 1.</description>
    <errorConditionFormula>OR(Confidence__c &lt; 0, Confidence__c &gt; 1)</errorConditionFormula>
    <errorMessage>Confidence must be between 0 and 1.</errorMessage>
</ValidationRule>

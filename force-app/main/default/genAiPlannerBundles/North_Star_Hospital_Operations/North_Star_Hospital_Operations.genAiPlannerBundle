        <fullName>p_16jg5000000abFZ_Communication_16jg5000000abFZ</fullName>
        <canEscalate>false</canEscalate>
        <description>Draft privacy-safe internal and customer communication for Slack, WhatsApp, and protected vendor email after approval.</description>
        <developerName>p_16jg5000000abFZ_Communication_16jg5000000abFZ</developerName>
        <genAiPluginInstructions>
            <description>WhatsApp is external customer/user intake and approved mobile/customer acknowledgement. Slack is internal team and manager coordination.</description>
            <developerName>north_star_instruction_0</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_0</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>

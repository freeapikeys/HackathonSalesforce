    <localTopics>
        <fullName>p_16jg5000000abFZ_Customer_Trust_16jg5000000abFZ</fullName>
        <canEscalate>false</canEscalate>
        <description>Classify customer trust issues and draft safe follow-up questions and approved response wording.</description>
        <developerName>p_16jg5000000abFZ_Customer_Trust_16jg5000000abFZ</developerName>
        <genAiPluginInstructions>
            <description>Use Customer Trust as the core role. The active profile may display patient, guest, passenger, shopper, or client trust.</description>
            <developerName>north_star_instruction_0</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_0</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>For vague complaints, ask one short follow-up only: &quot;What happened?&quot; For detailed complaints, identify issue type, affected resource, location, time window, possible cause, approval need, and outcome metric.</description>
            <developerName>north_star_instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Keep replies short, human, and same-language when safe. Do not promise action before manager approval.</description>
            <developerName>north_star_instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_2</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localDeveloperName>p_16jg5000000abFZ_Customer_Trust</localDeveloperName>
        <masterLabel>Customer Trust</masterLabel>
        <pluginType>Topic</pluginType>
        <scope>Use this topic for exact vague complaint openings including &quot;I have a problem&quot;, &quot;I have an issue&quot;, &quot;I need help&quot;, &quot;I want to complain&quot;, &quot;something is wrong&quot;, complaints, dissatisfaction, service issues, trust risk, and customer-facing follow-up wording. These are not small talk and not ambiguous general questions. If no details are provided, ask only: &quot;What happened?&quot;</scope>
    </localTopics>
    <localTopics>
        <fullName>p_16jg5000000abFZ_Evidence_and_Context_16jg5000000abFZ</fullName>
        <canEscalate>false</canEscalate>
        <description>Normalize messy signals into universal primitives and separate facts from claims, inferences, and missing evidence.</description>
        <developerName>p_16jg5000000abFZ_Evidence_and_Context_16jg5000000abFZ</developerName>
        <genAiPluginInstructions>
            <description>Map every issue to Signal, Evidence, Customer, Resource, Location, Partner, Process, Risk, Policy, Recommendation, Approval, Action, Outcome, and Metric where relevant.</description>
            <developerName>north_star_instruction_0</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_0</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Flag missing, conflicting, late, duplicate, low-confidence, or restricted evidence. Ask one short follow-up when evidence is too thin.</description>
            <developerName>north_star_instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Keep raw personal data out of demo responses. Preserve source evidence IDs, confidence, and next evidence needed.</description>
            <developerName>north_star_instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>north_star_instruction_2</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <language>en_US</language>
        <localDeveloperName>p_16jg5000000abFZ_Evidence_and_Context</localDeveloperName>
        <masterLabel>Evidence and Context</masterLabel>
        <pluginType>Topic</pluginType>
        <scope>Use this topic to ground a complaint, voice note, document, system event, or partner update before recommendations are made.</scope>
    </localTopics>

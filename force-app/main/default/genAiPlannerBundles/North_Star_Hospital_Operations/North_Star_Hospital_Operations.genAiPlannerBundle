            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Do not send messages directly. Preserve provider, status, fallback reason, evidence IDs, approval ID, action ID, and correlation ID after approved execution.</description>
